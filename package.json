{
  "name": "sustain",
  "displayName": "Sustain",
  "description": "View a repository's architecture as an Archify diagram and open the code behind each node.",
  "version": "0.2.0",
  "publisher": "sustain",
  "private": true,
  "engines": {
    "vscode": "^1.126.0",
    "node": ">=18"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sustain.installSkills",
        "title": "Install Agent Skills",
        "category": "Sustain"
      },
      {
        "command": "sustain.generateArchitecture",
        "title": "Generate Architecture",
        "category": "Sustain"
      },
      {
        "command": "sustain.openArchitecture",
        "title": "Open Architecture",
        "category": "Sustain"
      },
      {
        "command": "sustain.openArchitectureFile",
        "title": "Open Architecture File…",
        "category": "Sustain"
      },
      {
        "command": "sustain.startLearning",
        "title": "Start Learning Session",
        "category": "Sustain"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm run test && npm run check:docs && npm run build",
    "test:e2e": "npm run build && node esbuild.mjs --e2e && node out/e2e/runTest.js",
    "vscode:prepublish": "node esbuild.mjs",
    "package": "vsce package --no-dependencies --skip-license --allow-missing-repository"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "elkjs": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.6",
    "mocha": "12.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
